#! /bin/bash

# Generates a POTCAR based on the POSCAR in the current directory.
# A specific file can also be supplied as an argument and failing that
# the POTCAR is generated interactively.
# Requires the VASP_POTENTIALS environment variable to be set. If this points
# to a directory containing several potential sets, select one with
# --potential-set or VASP_POTENTIAL_SET.

usage() {
  echo "Usage: generate-potcar [-p POTENTIAL_SET] [POSCAR]"
  echo
  echo "Options:"
  echo "  -p, --potential-set SET  Select a potential set such as PBE.64 or LDA.64"
  echo "  -h, --help               Show this help message"
}

is_potential_dir() {
  local potentialDir="$1"
  local potcar

  for potcar in "$potentialDir"/*/POTCAR; do
    [ -f "$potcar" ] && return 0
  done

  return 1
}

potential_set_name() {
  local potentialDir="$1"
  local name="${potentialDir##*/}"
  echo "${name#potpaw_}"
}

discover_potential_sets() {
  local searchDir="$1"
  local potentialDir

  potentialDirs=()
  for potentialDir in "$searchDir"/*; do
    [ -d "$potentialDir" ] || continue
    is_potential_dir "$potentialDir" && potentialDirs+=("$potentialDir")
  done
}

select_potential_dir() {
  local potentialRoot="$1"
  local requestedSet="$2"
  local parentDir
  local candidate
  local nchoice
  local rootName
  local rootSetName

  if [ ! -d "$potentialRoot" ]; then
    echo "VASP_POTENTIALS directory doesn't exist: $potentialRoot" >&2
    exit 1
  fi

  rootName="${potentialRoot##*/}"
  rootSetName="$(potential_set_name "$potentialRoot")"

  if [ -n "$requestedSet" ]; then
    if [ -d "$requestedSet" ] && is_potential_dir "$requestedSet"; then
      echo "$requestedSet"
      return
    fi

    if { [ "$requestedSet" = "$rootName" ] || [ "$requestedSet" = "$rootSetName" ]; } && is_potential_dir "$potentialRoot"; then
      echo "$potentialRoot"
      return
    fi

    parentDir="$(dirname "$potentialRoot")"
    for candidate in "$potentialRoot/$requestedSet" "$potentialRoot/potpaw_$requestedSet" "$parentDir/$requestedSet" "$parentDir/potpaw_$requestedSet"; do
      if [ -d "$candidate" ] && is_potential_dir "$candidate"; then
        echo "$candidate"
        return
      fi
    done

    echo "Could not find potential set: $requestedSet" >&2
    discover_potential_sets "$potentialRoot"
    if [ "${#potentialDirs[@]}" -eq 0 ]; then
      discover_potential_sets "$parentDir"
    fi
    if [ "${#potentialDirs[@]}" -gt 0 ]; then
      echo "Available potential sets:" >&2
      for candidate in "${potentialDirs[@]}"; do
        echo "  - $(potential_set_name "$candidate") ($candidate)" >&2
      done
    fi
    exit 1
  fi

  if is_potential_dir "$potentialRoot"; then
    echo "$potentialRoot"
    return
  fi

  discover_potential_sets "$potentialRoot"

  if [ "${#potentialDirs[@]}" -eq 0 ]; then
    echo "No POTCAR directories found under VASP_POTENTIALS: $potentialRoot" >&2
    exit 1
  elif [ "${#potentialDirs[@]}" -eq 1 ]; then
    echo "${potentialDirs[0]}"
    return
  fi

  echo "Select a POTCAR potential set:" >&2
  for n in $(seq 1 "${#potentialDirs[@]}"); do
    echo "[$n] $(potential_set_name "${potentialDirs[$((n - 1))]}")" >&2
  done

  while true; do
    echo -e "\nEnter the number of the potential set you would like" >&2
    read nchoice

    if ! [ "$nchoice" -eq "$nchoice" 2>/dev/null ] || [ "$nchoice" -lt 1 ] || [ "$nchoice" -gt "${#potentialDirs[@]}" ]; then
      echo "Not a valid choice" >&2
    else
      echo "${potentialDirs[$((nchoice - 1))]}"
      return
    fi
  done
}

base=$(dirname "${BASH_SOURCE[0]}")
workingDir=$(pwd) # Where the script was called from
potentialSet="${VASP_POTENTIAL_SET:-}"
poscarArg=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -p|--potential-set)
      shift
      if [ "$#" -eq 0 ]; then
        echo "Missing value for --potential-set"
        usage
        exit 1
      fi
      potentialSet="$1"
      ;;
    --potential-set=*)
      potentialSet="${1#*=}"
      ;;
    -*)
      echo "Unknown option: $1"
      usage
      exit 1
      ;;
    *)
      if [ -n "$poscarArg" ]; then
        echo "Too many arguments supplied"
        usage
        exit 1
      fi
      poscarArg="$1"
      ;;
  esac
  shift
done

[[ -z "${VASP_POTENTIALS:-}" ]] && echo "VASP_POTENTIALS environment variable not set; see README" && exit 1

potentialDir="$(select_potential_dir "$VASP_POTENTIALS" "$potentialSet")"
echo "Using POTCAR potential set: $(potential_set_name "$potentialDir")"

# Check if user has supplied a POSCAR
file="POSCAR"
poscar=1
if [ -n "$poscarArg" ]; then
  if ! [ -f "$poscarArg" ]; then
    echo "$poscarArg doesn't exist"
    exit 1
  fi
  file="$poscarArg"
elif ! [ -f POSCAR ]; then
  echo "How many elements?"
  read nEl

  if ! [ "$nEl" -eq "$nEl" 2>/dev/null ]; then
    echo "Not a valid number of elements"
    exit 1
  fi
  poscar=0
fi

# We have a file we can use therefore extract the information from it
if [ $poscar -eq 1 ]; then
  # The sed is important for using POSCAR generated on Windows
  # Otherwise the last symbol isn't recognised properly. Such a pain
  # to debug.
  elementList=$("${base}/../vaspup/name-elements.sh" "$file" | sed $'s/\r//')
  nEl=$("${base}/../vaspup/num-elements.sh" "$file")
fi

# For each of the options, keep doing this loop until a choice has been
# made. When it has, copy the POTCAR working directory and continue
# with the next element.
for i in $(seq 1 $nEl); do

  while [ -z ${choice+x} ]; do # While a selection still hasn't been made

    if [ $poscar -eq 0 ]; then
      echo "Enter the symbol of element $i"
      read element
    else
      element=$(echo $elementList | awk -v i=$i '{print $i}')
    fi

    cd "$potentialDir" || exit 1

    # This regex is a bit hacky but it works
    pos=$(ls | grep "\(${element}_.*\)\|${element}\b\|\(${element}\..*\)")
    npos=$(echo $pos | wc -w)

    if [ "$npos" -eq 0 ]; then
      echo "Could not find a POTCAR for symbol: $element"
      poscar=0
    elif [ "$npos" -gt 1 ]; then

      echo "There are multiple POTCARs matching: $element"
      echo "Your options are:"

      for n in $(seq 1 $npos); do
        echo "[$n] $(echo $pos | awk '{print $'$n'}')"
      done

      while [ -z ${choice+x} ]; do # run this loop to a valid choice is chosen

        echo -e "\nEnter the number of the POTCAR you would like"
        read nchoice

        # Check the choice is an integer and one of the options
        if ! [ $nchoice -eq $nchoice 2>/dev/null ] || [ $nchoice -gt $npos ]; then
          echo "Not a valid choice"
        else
          choice=$(echo $pos | awk '{print $'$nchoice'}')
          echo "$choice added to POTCAR"
        fi
      done

    # If there is only one option, choose it and don't ask in the prompt
    elif [ "$npos" -eq 1 ]; then
      choice=$pos
    fi

  done

  # Move the POTCAR of choice to the working directory
  cp "$choice/POTCAR" "$workingDir/${i}_POTCAR" -f

  # Need unset so the while loop can work properly. It enables us to be understanding
  # if the user makes any mistakes.
  unset choice
done

cd "$workingDir" || exit 1

# Prepare the files for catenating
catCommand=""
for i in $(seq 1 $nEl); do
  catCommand+="${i}_POTCAR "
done

# Generate our POTCAR
cat $catCommand > POTCAR

# Remove the temporary files
for i in $(seq 1 $nEl); do
  rm "${i}_POTCAR"
done
